# Copie este arquivo como ".env" e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API Keys
# Use SOMENTE a chave pública (publishable / anon). Nunca a "secret" / "service_role".
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-chave-publica-aqui
# Opcional (público): ID do cliente OAuth do Google Cloud, para o botão oficial do Google
GOOGLE_CLIENT_ID=seu-id.apps.googleusercontent.com
